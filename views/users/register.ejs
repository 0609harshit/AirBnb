<% layout("templates/boilerplate.ejs") %>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="card-title mb-3 text-center">Create your account</h3>
                    <p class="text-muted text-center mb-4">Join now to manage listings, reviews, and bookings.</p>
                    <form action="/register" method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input id="username" type="text" name="username" class="form-control" placeholder="Enter username" autocomplete="username" required>
                            <div class="invalid-feedback">Please enter a username.</div>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email address</label>
                            <input id="email" type="email" name="email" class="form-control" placeholder="name@example.com" autocomplete="email" required>
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                        </div>
                        <div class="mb-4">
                            <label for="password" class="form-label">Password</label>
                            <input id="password" type="password" name="password" class="form-control" placeholder="Enter password" autocomplete="new-password" required>
                            <div class="form-text">Use at least 6 characters for better security.</div>
                            <div class="invalid-feedback">Please provide a password.</div>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Create Account</button>
                    </form>
                    <div class="text-center mt-4">
                        <small class="text-muted">Already registered? <a href="/login">Sign in</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
  'use strict'
  var forms = document.querySelectorAll('.needs-validation')
  Array.prototype.slice.call(forms)
    .forEach(function (form) {
      form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
})()
</script>